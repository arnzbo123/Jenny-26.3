{
  "schemaVersion": 1,
  "id": "sexmod",
  "version": "${version}",
  "name": "Goodcraft (Fabric migration development)",
  "description": "Fabric 26.3 migration foundation. The legacy mod's complete gameplay has not been ported or verified.",
  "environment": "*",
  "mixins": ["sexmod.mixins.json", {"config":"sexmod.client.mixins.json","environment":"client"}],
  "entrypoints": {
    "main": ["com.arn.goodmod.GoodcraftMod"],
    "client": ["com.arn.goodmod.GoodcraftClient"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_version}",
    "geckolib": "~${geckolib_version}"
  }
}
